generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  role          Role      @default(INFLUENCER)
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  brand         BrandProfile?
  influencer    InfluencerProfile?
  refreshTokens RefreshToken[]
  notifications Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt(sort: Desc)])
}

enum Role {
  BRAND
  INFLUENCER
  ADMIN
}

model BrandProfile {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  logo        String?
  description String?
  website     String?
  industry    String?
  verified    Boolean      @default(false)
  campaigns   Campaign[]
  directHires DirectHire[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model InfluencerProfile {
  id               String                @id @default(cuid())
  userId           String                @unique
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName      String
  avatar           String?
  bio              String?
  niche            String[]
  location         String?
  followersCount   Int                   @default(0)
  engagementRate   Float                 @default(0)
  rateCard         Json?
  minRate          Float?
  profileCompleted  Boolean               @default(false)
  verified          Boolean               @default(false)
  authenticityScore Float                 @default(0)
  qualityFlags      String[]              @default([])
  platforms         Platform[]
  applications     CampaignApplication[]
  invitations      CampaignInvitation[]
  directHires      DirectHire[]
  deliverables     CampaignDeliverable[]
  payments         Payment[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  FAILED
}

model Platform {
  id                 String             @id @default(cuid())
  influencerId       String
  influencer         InfluencerProfile  @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  name               PlatformName
  handle             String
  followers          Int                @default(0)
  verified           Boolean            @default(false)
  verificationCode   String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verificationMethod String?            // "AUTO_API" | "MANUAL_ADMIN"
  verifiedAt         DateTime?
  apiFollowerCount   Int?               // real count from platform API
  apiEngagementRate  Float?             // real engagement rate from platform API
  createdAt          DateTime           @default(now())

  @@unique([influencerId, name])
}

enum PlatformName {
  INSTAGRAM
  YOUTUBE
  TIKTOK
  TWITTER
  LINKEDIN
  PINTEREST
}

model Campaign {
  id           String                @id @default(cuid())
  brandId      String
  brand        BrandProfile          @relation(fields: [brandId], references: [id], onDelete: Cascade)
  title        String
  description  String
  budget       Float
  budgetType   BudgetType
  criteria     Json
  status       CampaignStatus        @default(DRAFT)
  campaignCode String                @unique @default(cuid())
  startDate    DateTime?
  endDate      DateTime?
  applications CampaignApplication[]
  invitations  CampaignInvitation[]
  payments     Payment[]
  deliverables CampaignDeliverable[]
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
}

enum BudgetType {
  FLAT_FEE
  CPA
  MIXED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model CampaignApplication {
  id           String               @id @default(cuid())
  campaignId   String
  campaign     Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencerId String
  influencer   InfluencerProfile    @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  status       ApplicationStatus    @default(PENDING)
  pitch        String?
  deliverable  CampaignDeliverable?
  payment      Payment?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([campaignId, influencerId])
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  APPROVED
  REJECTED
  WITHDRAWN
}

model CampaignInvitation {
  id           String            @id @default(cuid())
  campaignId   String
  campaign     Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  influencerId String
  influencer   InfluencerProfile @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  status       InvitationStatus  @default(PENDING)
  message      String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([campaignId, influencerId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model DirectHire {
  id           String               @id @default(cuid())
  brandId      String
  brand        BrandProfile         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  influencerId String
  influencer   InfluencerProfile    @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  title        String
  description  String
  budget       Float
  deliverables String
  deadline     DateTime?
  status       DirectHireStatus     @default(PENDING)
  brandMessage String?
  deliverable  CampaignDeliverable?
  payment      Payment?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

enum DirectHireStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  DECLINED
  CANCELLED
}

model Payment {
  id             String               @id @default(cuid())
  campaignId     String?
  campaign       Campaign?            @relation(fields: [campaignId], references: [id])
  influencerId   String?
  influencer     InfluencerProfile?   @relation(fields: [influencerId], references: [id])
  applicationId  String?              @unique
  application    CampaignApplication? @relation(fields: [applicationId], references: [id])
  directHireId   String?              @unique
  directHire     DirectHire?          @relation(fields: [directHireId], references: [id])
  amount         Float
  status         PaymentStatus        @default(PENDING)
  type           PaymentType
  lockedAt       DateTime?
  releasedAt     DateTime?
  releaseAfter   DateTime?
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([campaignId])
  @@index([influencerId])
}

enum PaymentStatus {
  PENDING
  LOCKED
  RELEASED
  DISPUTED
  REFUNDED
}

enum PaymentType {
  UPFRONT
  FLAT_FEE
  CPA_PAYOUT
  REFUND
}

model WaitlistEntry {
  id        String   @id @default(cuid())
  email     String   @unique
  role      Role
  name      String
  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum DeliverableStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

model CampaignDeliverable {
  id           String               @id @default(cuid())
  trackingCode String               @unique @default(cuid())
  targetUrl    String
  agreedBudget Float?

  campaignId    String?
  campaign      Campaign?            @relation(fields: [campaignId], references: [id])
  applicationId String?              @unique
  application   CampaignApplication? @relation(fields: [applicationId], references: [id])
  directHireId  String?              @unique
  directHire    DirectHire?          @relation(fields: [directHireId], references: [id])

  influencerId String
  influencer   InfluencerProfile    @relation(fields: [influencerId], references: [id])

  ytVideoId    String?
  ytViews      Int                  @default(0)
  ytLikes      Int                  @default(0)
  ytComments   Int                  @default(0)
  ytLastSynced DateTime?

  reportedReach       Int?
  reportedImpressions Int?
  reportedLikes       Int?
  reportedComments    Int?
  reportedShares      Int?
  reportedSaves       Int?

  totalClicks  Int                  @default(0)
  uniqueClicks Int                  @default(0)

  conversions  Int                  @default(0)
  revenue      Float                @default(0)

  status       DeliverableStatus    @default(ACTIVE)
  submittedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  clicks       DeliverableClick[]

  @@index([campaignId])
  @@index([influencerId])
}

model DeliverableClick {
  id            String              @id @default(cuid())
  deliverableId String
  deliverable   CampaignDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  clickedAt     DateTime            @default(now())
  ipHash        String

  @@index([deliverableId, clickedAt])
  @@index([deliverableId, ipHash])
}
